// =====================================================================
//  AVISOS DE WHATSAPP A TU MISMO NÚMERO (corre en Supabase, no en la web)
//  Cada vez que cobras a un cliente con tu atajo, te llega un mensaje con
//  cómo va el día y si ya cubriste la barbería del mes.
//
//  PASOS (una sola vez):
//  1) Activar CallMeBot (servicio gratis de terceros, solo uso personal):
//     - Guarda en tus contactos el número que aparece en https://www.callmebot.com/blog/free-api-whatsapp-messages/
//     - Mándale por WhatsApp:  I allow callmebot to send me messages
//     - Te responderá con tu APIKEY. Guárdala.
//  2) Supabase → Edge Functions → Create a new function → nombre: avisos-whatsapp
//     Pega TODO este archivo y pulsa Deploy.
//  3) Supabase → Edge Functions → Secrets → añade dos:
//       WA_PHONE   = tu número con + y código de país (ej. +5215512345678)
//       WA_APIKEY  = la clave que te dio CallMeBot
//  4) Supabase → Database → Webhooks → Create a new hook:
//       Tabla: turnos · Eventos: Insert y Update
//       Tipo: Supabase Edge Functions → función: avisos-whatsapp
//  5) Cambia abajo tu zona horaria y listo. Prueba cobrando un cliente.
// =====================================================================
import { createClient } from "https://esm.sh/@supabase/supabase-js@2";

const ZONA = "America/Mexico_City";   // <-- CAMBIA a tu zona horaria
const BARBER_BUDGET = 12000;          // igual que en el panel
const START_DATE = "2026-10-08";      // igual que en el panel
const SOLO_HITOS = false;             // true = solo avisa cuando logras la meta del día o cubres la barbería

const PHONE = Deno.env.get("WA_PHONE")!;
const APIKEY = Deno.env.get("WA_APIKEY")!;
const sb = createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_SERVICE_ROLE_KEY")!);

const money = (n: number) => (n < 0 ? "-$" : "$") + Math.abs(Math.round(n)).toLocaleString("en-US");
const hayCobro = (r: any) => r && r.precio_cobrado !== null && r.precio_cobrado !== undefined;
const ok = (t: string) => new Response(t, { status: 200 });

function diasDeTrabajo(desde: string, hasta: string): number {
  let n = 0;
  const d = new Date(desde + "T12:00:00"), e = new Date(hasta + "T12:00:00");
  while (d <= e) { if (d.getDay() !== 0) n++; d.setDate(d.getDate() + 1); }
  return Math.max(1, n);
}

Deno.serve(async (req) => {
  try {
    const body = await req.json();
    const rec = body.record, old = body.old_record;
    // Solo cuando un cliente ACABA de cobrarse (no al cambiar propinas ni otras cosas)
    if (!hayCobro(rec) || hayCobro(old) || !(Number(rec.precio_cobrado) > 0)) return ok("no es un cobro nuevo");

    const dia: string = rec.fecha || new Intl.DateTimeFormat("en-CA", { timeZone: ZONA }).format(new Date());
    const mes = dia.slice(0, 7);
    const primero = mes + "-01";
    const ultimo = new Date(+mes.slice(0, 4), +mes.slice(5, 7), 0);
    const ultimoStr = mes + "-" + String(ultimo.getDate()).padStart(2, "0");

    const [tm, gs, mt] = await Promise.all([
      sb.from("turnos").select("fecha,precio_cobrado,propina").gte("fecha", primero).lte("fecha", ultimoStr).not("precio_cobrado", "is", null),
      sb.from("gastos").select("monto").gte("fecha", primero).lte("fecha", ultimoStr),
      sb.from("metas").select("objetivo_ingresos").eq("mes", primero).maybeSingle(),
    ]);
    if (tm.error) throw tm.error;

    const filas = (tm.data || []).filter((r: any) => r.fecha >= START_DATE);
    const total = (l: any[]) => l.reduce((s, r) => s + Number(r.precio_cobrado || 0) + Number(r.propina || 0), 0);
    const delDia = filas.filter((r: any) => r.fecha === dia);
    const hoy = total(delDia);
    const clientes = delDia.filter((r: any) => Number(r.precio_cobrado) > 0).length;
    const mesIng = total(filas);
    const gastosMes = (gs.data || []).reduce((s: number, g: any) => s + Number(g.monto || 0), 0);
    const equilibrio = Math.max(BARBER_BUDGET, gastosMes);

    const meta = Number(mt.data?.objetivo_ingresos || 0);
    const inicio = primero < START_DATE ? START_DATE : primero;
    const metaDia = meta > 0 ? meta / diasDeTrabajo(inicio, ultimoStr) : 0;
    const ticket = clientes ? delDia.reduce((s: number, r: any) => s + Number(r.precio_cobrado || 0), 0) / clientes : 0;

    // Hitos: ¿con este cobro cruzaste la meta del día o el equilibrio del mes?
    const antes = Number(rec.precio_cobrado || 0) + Number(rec.propina || 0);
    const logroMetaDia = metaDia > 0 && hoy >= metaDia && hoy - antes < metaDia;
    const logroEquilibrio = mesIng >= equilibrio && mesIng - antes < equilibrio;
    if (SOLO_HITOS && !logroMetaDia && !logroEquilibrio) return ok("sin hito");

    const l: string[] = [];
    l.push("💈 Mono's · cobro registrado");
    l.push("Hoy: " + money(hoy) + " (" + clientes + " cliente" + (clientes === 1 ? "" : "s") + ")");
    if (metaDia > 0) {
      if (hoy >= metaDia) l.push("🎉 ¡Meta del día lograda! (" + money(metaDia) + ")");
      else {
        const falta = metaDia - hoy;
        l.push("Meta del día: faltan " + money(falta) + (ticket ? " (≈ " + Math.ceil(falta / ticket) + " clientes)" : ""));
      }
    } else l.push("Configura la meta del mes en el panel para ver la meta del día.");
    if (mesIng >= equilibrio) l.push("✅ Barbería del mes cubierta. Todo lo que entra es ganancia.");
    else l.push("Barbería del mes: " + money(mesIng) + " de " + money(equilibrio) + " (" + Math.round((mesIng / equilibrio) * 100) + "%)");

    const url = "https://api.callmebot.com/whatsapp.php?phone=" + encodeURIComponent(PHONE) +
      "&text=" + encodeURIComponent(l.join("\n")) + "&apikey=" + encodeURIComponent(APIKEY);
    const r = await fetch(url);
    if (!r.ok) console.error("CallMeBot respondió", r.status, await r.text());
    return ok("enviado");
  } catch (e) {
    console.error(e);
    return new Response(String(e), { status: 500 });
  }
});
