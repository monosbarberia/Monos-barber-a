drop policy if exists turnos_admin_leer on turnos;
create policy turnos_admin_leer on turnos for select to authenticated using (es_admin());
drop policy if exists turnos_admin_crear on turnos;
create policy turnos_admin_crear on turnos for insert to authenticated with check (es_admin());
drop policy if exists precios_admin on precios;
create policy precios_admin on precios for all to authenticated using (es_admin()) with check (es_admin());

-- 4) ACCIONES DEL PANEL
create or replace function marcar_estado(p_reserva text, p_estado text) returns void
language plpgsql security definer set search_path = public as $$
begin
  if not es_admin() then raise exception 'NO_AUTORIZADO'; end if;
  if p_estado = 'cancelado' then
    insert into turnos_cancelados select t.*, now(), null from turnos t where t.reserva_id::text = p_reserva;
    delete from turnos where reserva_id::text = p_reserva;
    delete from no_shows where reserva_id = p_reserva and estado = 'pendiente';
  elsif p_estado in ('ocupado', 'completado', 'no_show') then
    update turnos set estado = p_estado where reserva_id::text = p_reserva;
    if p_estado = 'no_show' then
      insert into no_shows (reserva_id, telefono, nombre, fecha, turno, monto)
        select p_reserva, t.telefono, t.nombre, t.fecha::date, t.turno, coalesce(t.total, 0)::numeric
        from turnos t where t.reserva_id::text = p_reserva limit 1
        on conflict (reserva_id) do nothing;
    else
      delete from no_shows where reserva_id = p_reserva and estado = 'pendiente';
    end if;
  end if;
end $$;

create or replace function resolver_no_show(p_id uuid, p_accion text) returns void
language plpgsql security definer set search_path = public as $$
begin
  if not es_admin() then raise exception 'NO_AUTORIZADO'; end if;
  update no_shows
     set estado = case p_accion when 'pagado' then 'pagado' when 'perdonado' then 'perdonado' else 'pendiente' end,
         resuelto_en = case when p_accion in ('pagado', 'perdonado') then now() else null end
   where id = p_id;
end $$;

-- Clientes con deuda que YA tienen una cita nueva (es el aviso del panel)
create or replace function alertas_deuda() returns jsonb
language sql stable security definer set search_path = public as $$
  select coalesce(jsonb_agg(x), '[]'::jsonb) from (
    select t.reserva_id::text as reserva_id, max(t.nombre) as nombre, t.telefono,
           t.fecha::date as fecha, min(t.turno) as turno, d.deuda
    from turnos t
    join (select telefono, sum(monto) as deuda from no_shows where estado = 'pendiente' group by telefono) d
      on d.telefono = t.telefono
    where es_admin() and t.estado = 'ocupado' and t.fecha::date >= current_date
    group by t.reserva_id, t.telefono, t.fecha, d.deuda
  ) x;
$$;

revoke all on function marcar_estado(text, text), resolver_no_show(uuid, text), alertas_deuda(), soy_admin() from public, anon;
grant execute on function marcar_estado(text, text), resolver_no_show(uuid, text), alertas_deuda(), soy_admin() to authenticated;
