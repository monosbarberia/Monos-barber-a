-- 0) TU CORREO: solo este correo podrá entrar al panel. CÁMBIALO AQUÍ.
create table if not exists admin_emails (email text primary key);
alter table admin_emails enable row level security;
insert into admin_emails (email) values ('TU_CORREO@ejemplo.com') on conflict do nothing;

create or replace function es_admin() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from admin_emails
                 where lower(email) = lower(coalesce(auth.jwt() ->> 'email', '')));
$$;

create or replace function soy_admin() returns boolean
language sql stable security definer set search_path = public as $$ select es_admin(); $$;

-- 1) BLOQUEOS (días u horas que no quieres atender)
create table if not exists bloqueos (
  id uuid primary key default gen_random_uuid(),
  fecha date not null,
  turno text,            -- null = todo el día
  motivo text,
  creado timestamptz default now()
);
alter table bloqueos enable row level security;
drop policy if exists bloqueos_publico on bloqueos;
create policy bloqueos_publico on bloqueos for select to anon, authenticated using (true);
drop policy if exists bloqueos_admin on bloqueos;
create policy bloqueos_admin on bloqueos for all to authenticated using (es_admin()) with check (es_admin());

-- La reserva se rechaza si el horario está bloqueado (aunque alguien lo intente saltar)
create or replace function bloquear_turnos() returns trigger language plpgsql as $$
begin
  if exists (select 1 from bloqueos b where b.fecha = new.fecha::date and (b.turno is null or b.turno = new.turno)) then
    raise exception 'BLOQUEADO';
  end if;
  return new;
end $$;
drop trigger if exists trg_bloqueos on turnos;
create trigger trg_bloqueos before insert on turnos for each row execute function bloquear_turnos();

-- 2) CITAS CANCELADAS (historial) y NO-SHOW (deudas)
create table if not exists turnos_cancelados as select * from turnos where false;
alter table turnos_cancelados add column if not exists cancelado_en timestamptz default now();
alter table turnos_cancelados add column if not exists motivo text;
alter table turnos_cancelados enable row level security;
drop policy if exists canc_admin on turnos_cancelados;
create policy canc_admin on turnos_cancelados for select to authenticated using (es_admin());

create table if not exists no_shows (
  id uuid primary key default gen_random_uuid(),
  reserva_id text unique,
  telefono text not null,
  nombre text,
  fecha date,
  turno text,
  monto numeric default 0,
  estado text default 'pendiente',   -- pendiente | pagado | perdonado
  creado timestamptz default now(),
  resuelto_en timestamptz
);
alter table no_shows enable row level security;
drop policy if exists ns_admin on no_shows;
create policy ns_admin on no_shows for select to authenticated using (es_admin());

